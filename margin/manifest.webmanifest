{
  "id": "./",
  "name": "Margin — E-book Reader",
  "short_name": "Margin",
  "description": "An offline e-book reader for EPUB, PDF, MOBI, comics and more, with highlights, dictionary, read-aloud and reading stats.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#eef0ed",
  "theme_color": "#2b5884",
  "categories": [
    "books",
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/epub+zip": [
          ".epub"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/x-mobipocket-ebook": [
          ".mobi",
          ".prc",
          ".azw"
        ],
        "application/vnd.amazon.ebook": [
          ".azw3"
        ],
        "application/x-fictionbook+xml": [
          ".fb2",
          ".fbz"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.comicbook+zip": [
          ".cbz"
        ],
        "application/vnd.comicbook-rar": [
          ".cbr"
        ],
        "application/x-cb7": [
          ".cb7"
        ],
        "application/x-cbt": [
          ".cbt"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "icons": [
        {
          "src": "icons/icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "book",
          "accept": [
            ".azw",
            ".azw3",
            ".cb7",
            ".cbr",
            ".cbt",
            ".cbz",
            ".docx",
            ".epub",
            ".fb2",
            ".fbz",
            ".mobi",
            ".pdf",
            ".prc",
            ".txt",
            "application/epub+zip",
            "application/pdf",
            "application/vnd.amazon.ebook",
            "application/vnd.comicbook+zip",
            "application/vnd.comicbook-rar",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/x-cb7",
            "application/x-cbt",
            "application/x-fictionbook+xml",
            "application/x-mobipocket-ebook",
            "text/plain"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}